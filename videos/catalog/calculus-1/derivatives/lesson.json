  "practice": [
    {
      "prompt": "Starting from the difference quotient for f(x)=x² at x=−2, simplify it for h≠0 and find the derivative.",
      "answer": "[(-2+h)²−4]/h=(-4h+h²)/h=−4+h for h≠0. The derivative is −4.",
      "id": "calculus-1.derivatives.video-practice-1"
    },
    {
      "prompt": "Use expansion to find the derivative of f(x)=x³ at x=1 from [f(1+h)−f(1)]/h.",
      "answer": "[(1+h)³−1]/h=(3h+3h²+h³)/h=3+3h+h² for h≠0; the limit is 3.",
      "id": "calculus-1.derivatives.video-practice-2"
    },
    {
      "prompt": "Explain why f(x)=|x| can be continuous at zero but have no derivative there. Give the two one-sided slopes.",
      "answer": "Both function values approach f(0)=0, so continuity holds. The left slope is −1 and the right slope is +1, so the derivative does not exist.",
      "id": "calculus-1.derivatives.video-practice-3"
    }
  ],
  "takeaway": "The derivative is a limit of nonzero-input-change quotients; simplify legally before taking the limit.",
